# no query string in the log: personal downloads carry the access token there
log_format lambda '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

limit_req_zone $binary_remote_addr zone=lambda_signin:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=lambda_codes:10m rate=30r/m;
limit_req_status 429;

server {
    listen 8080;
    server_tokens off;
    access_log /var/log/nginx/access.log lambda;

    # behind a reverse proxy every client would share its address, and with it the rate limits
    set_real_ip_from ${TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/snippets/headers.conf;

    # Docker's DNS: upstreams are resolved per request, so a restarted service with a new IP is picked up
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $auth http://${AUTH_UPSTREAM};
    set $core http://${CORE_UPSTREAM};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 64k;

    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=lambda_signin burst=5 nodelay;
        proxy_pass $auth;
    }

    location /api/auth/ { proxy_pass $auth; }
    # public signing key: other services of the same accounts verify tokens with it
    location = /.well-known/jwks.json { proxy_pass $auth; }
    location /api/invites { proxy_pass $auth; }
    location /api/users { proxy_pass $auth; }

    location = /api/share {
        limit_req zone=lambda_codes burst=10 nodelay;
        proxy_pass $core;
    }

    location ~ ^/api/(share|files)/ {
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass $core;
    }

    location /api/files { proxy_pass $core; }
    location /api/feedback { proxy_pass $core; }

    location /api/ { return 404; }
    location /actuator/ { return 404; }

    location /fonts/ {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
